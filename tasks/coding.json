      "title": "Binary search first occurrence",
      "prompt": "Write a Python function `binary_search(arr: list[int], target: int) -> int` that returns the index of the first occurrence of target in sorted list arr, or -1 if not present. Assume arr is sorted in ascending order.",
      "check": {
        "type": "code_exec",
        "entrypoint": "binary_search",
        "cases": [
          {
            "args": [
              [
                1,
                2,
                3,
                4,
                5
              ],
              3
            ],
            "expect": 2
          },
          {
            "args": [
              [
                1,
                2,
                2,
                2,
                3
              ],
              2
            ],
            "expect": 1
          },
          {
            "args": [
              [],
              5
            ],
            "expect": -1
          },
          {
            "args": [
              [
                1,
                2,
                3,
                4,
                5
              ],
              6
            ],
            "expect": -1
          },
          {
            "args": [
              [
                1,
                1,
                1,
                1
              ],
              1
            ],
            "expect": 0
          }
        ],
        "timeout_s": 10
      },
      "reference": "def binary_search(arr: list[int], target: int) -> int:\n    lo, hi = 0, len(arr) - 1\n    result = -1\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        if arr[mid] == target:\n            result = mid\n            hi = mid - 1  # continue left\n        elif arr[mid] < target:\n            lo = mid + 1\n        else:\n            hi = mid - 1\n    return result"
    }
