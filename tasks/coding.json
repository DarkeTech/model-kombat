    {
      "id": "coding-005",
      "lane": "coding",
      "difficulty": 3,
      "title": "Merge two sorted lists",
      "prompt": "Write a Python function `merge_sorted(a: list[int], b: list[int]) -> list[int]` that merges two sorted lists of integers into a new sorted list. Do not modify inputs. Assume a and b are sorted in ascending order.",
      "check": {
        "type": "code_exec",
        "entrypoint": "merge_sorted",
        "cases": [
          {
            "args": [
              [
                1,
                3,
                5
              ],
              [
                2,
                4,
                6
              ]
            ],
            "expect": [
              1,
              2,
              3,
              4,
              5,
              6
            ]
          },
          {
            "args": [
              [],
              [
                1,
                2
              ]
            ],
            "expect": [
              1,
              2
            ]
          },
          {
            "args": [
              [
                1,
                2,
                3
              ],
              []
            ],
            "expect": [
              1,
              2,
              3
            ]
          },
          {
            "args": [
              [
                1,
                1,
                2
              ],
              [
                1,
                3,
                4
              ]
            ],
            "expect": [
              1,
              1,
              1,
              2,
              3,
              4
            ]
          },
          {
            "args": [
              [],
              []
            ],
            "expect": []
          }
        ],
        "timeout_s": 10
      },
      "reference": "def merge_sorted(a: list[int], b: list[int]) -> list[int]:\n    i = j = 0\n    result = []\n    while i < len(a) and j < len(b):\n        if a[i] <= b[j]:\n            result.append(a[i])\n            i += 1\n        else:\n            result.append(b[j])\n            j += 1\n    result.extend(a[i:])\n    result.extend(b[j:])\n    return result"
    },
